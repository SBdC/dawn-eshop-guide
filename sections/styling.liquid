<div class="custom-hero-section">
    <style>
        .custom-hero-section {
            text-align: left;
            background: #f6f6f6;
            position: relative;
            height: 450px;
            object-fit: cover;
        }
        .custom-hero-section .hero-image {
            width: 100%;
            height: 100%;
            border-radius: 8px;
            object-fit: cover;
        }
        .styling-wrapper {
            position: absolute;
            top: 3rem;
            left: 3rem;
            border-radius: 24px;
            padding: 1rem 3rem;
            background-color: white;
        }
        .custom-hero-section .hero-title {
            font-size: 2.5em;
            margin-bottom: 0.5em;
            text-align: left;
        }
        .custom-hero-section .hero-subtitle {
            font-size: 1.5em;
            margin-top: 0.5em;
            text-align: left;
        }
    </style>
    <div class="styling-wrapper">
        {% if section.settings.hero_title != blank %}
            <h1 class="hero-title">{{ section.settings.hero_title }}</h1>
        {% endif %}
        {% if section.settings.hero_subtitle != blank %}
            <h2 class="hero-subtitle">{{ section.settings.hero_subtitle }}</h2>
        {% endif %}
    </div>
    {% if section.settings.hero_image != blank %}
        <img class="hero-image"
             src="{{ section.settings.hero_image | image_url: width: 1600 }}"
             alt="{{ section.settings.hero_title | escape }}">
    {% endif %}
</div>

{% schema %}
{
    "name": "Hero for Styling",
    "settings": [
        {
        "type": "image_picker",
        "id": "hero_image",
        "label": "Hero Image"
        },
        {
        "type": "text",
        "id": "hero_title",
        "label": "Hero Title",
        "default": "Styling Headline"
        },
        {
        "type": "text",
        "id": "hero_subtitle",
        "label": "Hero Subtitle",
        "default": "let's shop"
        }
    ],
    "presets": [
        {
        "name": "Hero for Styling"
        }
    ]
}
{% endschema %}